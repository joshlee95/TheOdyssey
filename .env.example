# Copyright (c) 2026 heojunfo
# 이 파일을 .env로 복사해서 쓰세요 (cp .env.example .env). .env는 git에 올라가지 않아요.
# API 키는 게임 화면의 ⚙️ 설정에서 넣어도 됩니다 (설정 화면 값이 우선).

# Anthropic API 키 — 없으면 모의 GM으로 동작
ANTHROPIC_API_KEY=

# GM 모델 (기본 claude-opus-5-5) · 생각의 깊이 low / medium / high (기본 high)
# GM_MODEL=claude-opus-5-5
# GM_EFFORT=high

# 포트 (기본 3000)
# PORT=3000

# 키가 있어도 모의 GM을 쓰려면
# GM=mock

# 한 서버에 둘 수 있는 방 개수 (기본 100)
# MAX_ROOMS=100

# 터널 등으로 주소와 접속 주소가 다를 때만: 허용할 출처를 쉼표로 (예: https://my-odyssey.ngrok.app)
# ALLOWED_ORIGINS=
