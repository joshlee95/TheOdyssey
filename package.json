{
  "name": "the-odyssey",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:mock": "GM=mock node --import tsx server/index.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "validate": "tsx scripts/validate-islands.ts",
    "island:build": "node --env-file-if-exists=.env --import tsx scripts/build-island.ts",
    "test": "node --import tsx --test shared/*.test.ts server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint:prose": "tsx scripts/lint-prose.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "socket.io": "^4.8.3",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
